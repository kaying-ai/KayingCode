# 在 nginx server 块中加入（按实际域名/证书调整）。
# 默认要求 basic auth；如只在内网/Tailscale 访问，可改为 allow/deny。

location = /kaying-bot/kaying-taptap-daily {
    return 301 /kaying-bot/kaying-taptap-daily/;
}

location /kaying-bot/kaying-taptap-daily/ {
    alias /srv/kaying-bot/kaying-taptap-daily/workspace/reports/;
    index index.html;
    autoindex off;

    auth_basic "TapTap Daily";
    auth_basic_user_file /etc/nginx/.htpasswd-kaying-taptap-daily;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-store" always;
}
