{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kayingcode-relay-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "WEB_REMOTE", "class_name": "WebRemoteRelayObject" }
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayObject"] },
    { "tag": "v2-web-remote", "new_sqlite_classes": ["WebRemoteRelayObject"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
}
