{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kayingcode/kayingcode-cua-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "KayingCode built-in Computer Use plugin backed by a pinned kaying-computer-use runtime snapshot.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/verify-package.mjs",
    "build:native": "node scripts/build-native-runtime.mjs && node scripts/verify-package.mjs",
    "lint": "oxlint src scripts test --no-ignore",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
