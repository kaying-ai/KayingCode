# TapTap 游戏日报服务环境变量
# 权限：0640 root:taptap；不要提交真实 webhook 或模型密钥。
# 模型 Provider 配置使用 KayingCode 现有配置（$HOME/.kayingcode/cli/config.json 或环境变量）。

# 可选：显式指定 kayingcode 可执行文件
# KAYINGCODE_BIN=/opt/kayingcode/bin/kayingcode

# headless 权限模式：先保持 build；确认 world.run 可用后再评估是否放宽
TAPTAP_DAILY_MODE=build
TAPTAP_DAILY_TIMEOUT_SECONDS=3600
TAPTAP_DAILY_RETRY_TIMEOUT_SECONDS=1200

# 数据与采集
TAPTAP_DAILY_SOURCE=http
# 服务器出口被 TapTap WAF 拦截时，使用 Cloudflare Worker 代理；留空则直连。
# 当前配套代理：https://taptap-proxy.opentaptap.dev
TAPTAP_PROXY_BASE_URL=
TAPTAP_PROXY_TOKEN=
TAPTAP_DAILY_CALENDAR_DAYS=30
TAPTAP_DAILY_MAX_NEW_GAMES=4
TAPTAP_DAILY_MAX_TRACKS=5
TAPTAP_DAILY_CONCURRENCY=5
# 子代理模型（providerId/modelId）；留空则继承父会话模型。
# 本服务统一使用 deepseek-v4.1-flash，主代理与所有子代理保持一致。
TAPTAP_DAILY_SUBAGENT_MODEL=opencode-go-chat/deepseek-v4.1-flash

# 报告公开地址（用于飞书摘要链接），例如：
# REPORT_PUBLIC_BASE_URL=https://example.com/kaying-bot/kaying-taptap-daily
REPORT_PUBLIC_BASE_URL=

# 飞书自定义机器人 webhook；留空则跳过推送
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
# 失败告警可单独配置；留空时回退到 LARK_WEBHOOK_URL
LARK_ALERT_WEBHOOK_URL=
