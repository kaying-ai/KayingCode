node-linker=hoisted
# 包管理器为 pnpm；pnpm 与 npm 都会读取用户级 ~/.npmrc，若其中 ignore-scripts=true
# 会静默跳过所有依赖生命周期脚本（electron 二进制下载、node-pty/koffi 原生构建等）。
# pnpm 时代由 pnpm-workspace.yaml 的 allowBuilds 白名单单独放行，迁移 pnpm 后必须在项目级显式恢复。
ignore-scripts=false
# 依赖闭包注入均按 hoisted 语义设计，显式固定 hoisted，避免布局漂移。
# 国内网络线路优化：npmmirror（淘宝）镜像源
registry=https://registry.npmmirror.com
# Electron 预编译二进制镜像（避免从 GitHub releases 下载超时）
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
# node-gyp 编译原生模块（node-pty、ssh2、koffi 等）所需的 Node 头文件镜像
disturl=https://npmmirror.com/mirrors/node/
