# KayingCode.localrun：无官方账号/CDN/订阅端点。
# 模型请在应用内配置 Provider（API Key / baseUrl），无需下列官方业务地址。
# 以下变量仅在自建网关/内网镜像时按需填写；默认全部留空且不访问 kayingcode 官方域。

# 可选本地 Provider 配置文件路径
KAYINGCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署依赖镜像（可选）
KAYINGCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
KAYINGCODE_DIST_BASE_URL=

# 本地数据根（可选）；默认 ~/.kayingcode（实现切换完成后生效，当前阶段见计划文档）
# KAYINGCODE_DATA_BASE_DIR=

# 开发态 React Scan 性能工具（默认关闭）；需要查看渲染/FPS 时设为 1
# KAYINGCODE_REACT_SCAN=1
