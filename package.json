{
  "name": "kayingcode",
  "version": "0.1.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @zcode/server run dev\" \"pnpm --filter @zcode/web run dev\"",
    "dev:desktop": "pnpm run dev:desktop:prod",
    "dev:desktop:test": "node scripts/dev-desktop-env.mjs test",
    "dev:desktop:prod": "node scripts/dev-desktop-env.mjs production",
    "dev:desktop:bytecode": "node scripts/dev-desktop-env.mjs production --agent-bytecode",
    "dev:desktop:remote-prod": "node scripts/dev-desktop-remote-prod.mjs",
    "dev:server": "pnpm --filter @zcode/server run dev",
    "prepare": "husky",
    "prepare:desktop-runtime": "pnpm --filter @zcode/desktop run prepare:runtime-assets",
    "dep:graph": "node scripts/dependency-graph.mjs",
    "dep:refs": "node scripts/dep-refs.mjs",
    "verify:pre-push": "pnpm run public:snapshot:check && pnpm run source:check && pnpm run lint && pnpm run architecture:check --changed",
    "public:snapshot:check": "node scripts/check-public-snapshot.mjs",
    "build": "turbo run build",
    "build:desktop-agent:bytecode": "node scripts/build-desktop-agent-bytecode.mjs",
    "build:kayingcode": "node scripts/build-kayingcode.mjs",
    "build:bootstrap": "turbo run build --filter=\"./packages/*\" --filter=\"./apps/zcode-cli/packages/*\" --filter=\"!@zcode/desktop\" && pnpm --filter @zcode/desktop run build:no-runtime-assets",
    "build:sea": "pnpm --dir apps/zcode-cli/packages/cli run build:sea",
    "build:sea:all": "pnpm install && pnpm --dir apps/zcode-cli/packages/cli run build:sea",
    "build:native-search": "node scripts/build-native-search-tools.mjs",
    "pack:native-search": "node scripts/package-native-search-tools.mjs",
    "clean": "node scripts/clean.mjs",
    "killall": "node scripts/kill-dev-processes.mjs",
    "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/agent-gateway packages/services packages/client packages/mobile-client-core packages/server packages/zcode-server-cli packages/ui packages/web apps/kayingcode-mobile-taro packages/desktop && pnpm --filter @kayingcode/relay-cloudflare run typecheck",
    "bundle:desktop": "pnpm --filter @zcode/desktop run bundle",
    "package": "pnpm run bundle:desktop",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "count-lines": "bash scripts/count-lines.sh",
    "prepare:remote-assets": "pnpm --filter @zcode/desktop run prepare:remote-assets",
    "prepare:remote-assets:linux": "pnpm --filter @zcode/server-cli stage:remote-assets --linux",
    "doctor:macos-release": "bash scripts/doctor-macos-release-app.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:with-remote": "node scripts/bootstrap.mjs --with-remote",
    "release": "release-it",
    "release:cli": "pnpm --dir apps/zcode-cli/packages/cli run release",
    "release:cli:dry": "pnpm --dir apps/zcode-cli/packages/cli run release:dry",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:report": "node scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "node scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context",
    "build:cli-assets": "turbo run build --filter=\"./packages/*\" --filter=\"./apps/zcode-cli/packages/*\" --filter=\"./plugins/*\"",
    "source:check": "node scripts/check-source-layout.mjs && pnpm run source:plugins:check && pnpm run source:map:check",
    "source:plugins": "node scripts/generate-official-plugin-catalog.mjs",
    "source:plugins:check": "node scripts/generate-official-plugin-catalog.mjs --check",
    "source:map": "node scripts/generate-source-map.mjs",
    "source:map:check": "node scripts/generate-source-map.mjs --check"
  },
  "dependencies": {
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^8.4.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "^29.1.1",
    "knip": "^6.0.6",
    "lint-staged": "^17.0.8",
    "node-pty": "1.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "1.60.0",
    "postject": "1.0.0-alpha.6",
    "release-it": "^19.2.4",
    "spdx-expression-parse": "4.0.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "turbo": "2.9.14",
    "typescript": "^6.0.2",
    "yaml": "^2.9.0",
    "yazl": "^3.3.1"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "overrides": {
      "@ai-sdk/openai-compatible": "2.0.60",
      "@pierre/diffs": "1.1.22",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@electron/rebuild>node-abi": "4.37.0",
      "electron-to-chromium": "1.5.452"
    },
    "patchedDependencies": {
      "@arms/rum-electron@0.0.3": "patches/@arms__rum-electron@0.0.3.patch",
      "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
      "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch",
      "@aiden0z/pptx-renderer@1.2.4": "patches/@aiden0z__pptx-renderer@1.2.4.patch",
      "@extend-ai/react-xlsx@0.16.0": "patches/@extend-ai__react-xlsx@0.16.0.patch"
    }
  }
}
