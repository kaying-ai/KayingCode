[Unit]
Description=Kaying Bot TapTap Daily Report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@STATE_ROOT@/workspace
Environment=HOME=@STATE_ROOT@
Environment=KAYINGCODE_DATA_BASE_DIR=@STATE_ROOT@
Environment=TZ=Asia/Shanghai
EnvironmentFile=-@CONFIG_ROOT@/report.env
ExecStart=@BOT_ROOT@/run-report.sh
TimeoutStartSec=7200
KillMode=control-group
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@STATE_ROOT@ @RUN_ROOT@
RestrictSUIDSGID=true
Nice=10
